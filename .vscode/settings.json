{
  "workbench.colorTheme": "Dracula Theme",
  "git.confirmSync": false,
  "editor.wordWrap": "on",
  "editor.stickyScroll.enabled": false,
  "notebook.stickyScroll.enabled": true,
  "window.menuBarVisibility": "classic",
  "github.copilot.nextEditSuggestions.enabled": true,
  "githubPullRequests.codingAgent.promptForConfirmation": false,
  "chat.agent.maxRequests": 150,
  "chat.agent.thinkingStyle": "collapsedPerItem",
  "chat.agent.todoList": {
    "position": "default"
  },
  "chat.editing.confirmEditRequestRetry": false,
  "chat.fontSize": 11,
  "chat.editor.fontSize": 10,
  "chat.emptyState.history.enabled": true,
  "window.nativeTabs": true,
  "github.copilot.chat.alternateGptPrompt.enabled": true,
  "editor.fontSize": 11,
  "markdown.preview.fontSize": 11,
  "debug.console.fontSize": 11,
  "scm.inputFontSize": 11,
  "terminal.integrated.fontSize": 9,
  "editor.minimap.sectionHeaderFontSize": 11,
  "liveServer.settings.donotShowInfoMsg": true,
  "chat.tools.terminal.autoApprove": {
    "sed": true,
    "nl": true,
    "cd \"/Users/oscarboczarski/Library/Mobile Documents/com~apple~CloudDocs/🔬Research+/🧑‍💻 Code.Base/DH-P3-1\" && nl -ba <(git show 8806fbdb612a6cf276cf8d9d001aa6bd9b11c5d1:DH_P2.53/styles/styles.css) | sed -n '1420,1445p'": {
      "approve": true,
      "matchCommandLine": true
    },
    "git difftool": true,
    "git checkout": true,
    "git rev-list": true
  },
  "remoteHub.commitDirectlyWarning": "off",
  "git.enableSmartCommit": true,
  "chat.edits2.enabled": true,
  "workbench.editor.enablePreview": false,

  "workbench.colorCustomizations": {
    "[Dracula Theme]": {
      "editor.selectionBackground": "#7430a4cb",
      "editor.inactiveSelectionBackground": "#7430a443",
      "editor.selectionHighlightBackground": "#8036b58a"
    }
  },

  "editor.tokenColorCustomizations": {
    "[Dracula Theme]": {
      "textMateRules": [
        {
          "name": "Strings → rose",
          "scope": [
            "string",
            "string.quoted",
            "string.quoted.double",
            "string.quoted.single",
            "string.template",
            "constant.character.escape"
          ],
          "settings": { "foreground": "#ff4d97" }
        },
        {
          "name": "HTML/JSX attribute names → rose",
          "scope": [
            "entity.other.attribute-name",
            "meta.tag.attribute",
            "support.variable.property.dom",
            "support.variable.property"
          ],
          "settings": { "foreground": "#46f8bd" }
        },

        /* Markdown comments → salmon */
        {
          "name": "Markdown comments → salmon",
          "scope": [
            "text.html.markdown comment",
            "text.html.markdown punctuation.definition.comment"
          ],
          "settings": { "foreground": "#FA8072" }
        }
      ]
    }
  },

  "editor.semanticTokenColorCustomizations": {
    "[Dracula Theme]": {
      "enabled": true,
      "rules": {
        "string": "#bc8692",
        "property": "#cbd6a2",
        "enumMember": "#e8738c"
      }
    }
  },

  /* ---------- TODO Highlight (Markdown-only, no yellow background) ---------- */
  "todohighlight.include": ["**/*.md"],
  "todohighlight.isCaseSensitive": true,
  "todohighlight.defaultStyle": {
    "backgroundColor": "#00000000",
    "overviewRulerColor": "#00000000",
    "border": "none"
  },
  "todohighlight.keywords": [
    { "text": "app.js",      "color": "#F7DF1E", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "styles.css",  "color": "#2965F1", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "index.html",  "color": "#E34F26", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "rosters.html","color": "#E34F26", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ".css",  "color": "#2965F1", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ".js",   "color": "#F7DF1E", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ".html", "color": "#E34F26", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ".md",   "color": "#00B894", "backgroundColor": "#00000000", "isWholeLine": false },

    { "text": "0. ", "color": "#B388FF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "1. ", "color": "#4FC3F7", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "2. ", "color": "#26F0E0", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "3. ", "color": "#7CFB76", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "4. ", "color": "#FFE26A", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "5. ", "color": "#FFB86C", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "6. ", "color": "#FF7AB6", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "7. ", "color": "#D58CFF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "8. ", "color": "#7DE7FF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "9. ", "color": "#B2FF9E", "backgroundColor": "#00000000", "isWholeLine": false },

    { "text": "0) ", "color": "#B388FF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "1) ", "color": "#4FC3F7", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "2) ", "color": "#26F0E0", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "3) ", "color": "#7CFB76", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "4) ", "color": "#FFE26A", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "5) ", "color": "#FFB86C", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "6) ", "color": "#FF7AB6", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "7) ", "color": "#D58CFF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "8) ", "color": "#7DE7FF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "9) ", "color": "#B2FF9E", "backgroundColor": "#00000000", "isWholeLine": false },

    { "text": "•",  "color": "#02FFDB", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ".", "color": "#C999FF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "//", "color": "#C999FF", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "*",  "color": "#FF7099", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "#",  "color": "#77DD99", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "—",  "color": "#93C5FD", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "-",  "color": "#93C5FD", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "⸻",  "color": "#8CFFC2", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "⸺",  "color": "#8CFFC2", "backgroundColor": "#00000000", "isWholeLine": false },

    { "text": "}",  "color": "#77DD99", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "{",  "color": "#77DD99", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "(", "color": "#26F0E0", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ")", "color": "#26F0E0", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "<", "color": "#B0FF33", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": ">", "color": "#B0FF33", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "[", "color": "#FF25D4", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "]", "color": "#FF25D4", "backgroundColor": "#00000000", "isWholeLine": false },

    { "text": "oscarbrandsllc:",  "color": "#FF6AB4", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "GitHub Copilot:",  "color": "#FA8072", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "⤵️ NEW PROMPT ⤵️", "color": "#FF6AB4", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "<!-- —————————————————————— ⤵️ NEW PROMPT ⤵️ ——————————————————————— -->",
      "color": "#FF6AB4", "backgroundColor": "#00000000", "isWholeLine": false },
    { "text": "<!-- —————————————————————— ⤵️ Copilot Response ⤵️ ——————————————————————— -->", "color": "#FA8072", "backgroundColor": "#00000000", "isWholeLine": false }
  ],
  /* ------------------------------------------------------------------------ */

  "liveServer.settings.port": 5507,
  "editor.colorDecorators": true,
  "editor.colorDecoratorsLimit": 2200,
  "chat.checkpoints.showFileChanges": true,
  "chat.todoListTool.descriptionField": true,
  "inlineChat.enableV2": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.tools.memory.enabled": true,
  "chat.renderRelatedFiles": true,
  "github.copilot.chat.newWorkspace.useContext7": true
}