{
  "workbench.colorTheme": "Dracula Theme",
  "git.confirmSync": false,
  "editor.wordWrap": "on",
  "editor.stickyScroll.enabled": false,
  "notebook.stickyScroll.enabled": true,
  "window.menuBarVisibility": "classic",
  "github.copilot.nextEditSuggestions.enabled": true,
  "githubPullRequests.codingAgent.promptForConfirmation": false,
  "chat.agent.maxRequests": 50,
  "chat.agent.thinkingStyle": "collapsedPerItem",
  "chat.agent.todoList": { "position": "default" },
  "chat.editing.confirmEditRequestRetry": false,
  "chat.fontSize": 11,
  "chat.editor.fontSize": 10,
  "chat.emptyState.history.enabled": true,
  "window.nativeTabs": true,
  "github.copilot.chat.alternateGptPrompt.enabled": true,
  "editor.fontSize": 11,
  "markdown.preview.fontSize": 11,
  "debug.console.fontSize": 11,
  "scm.inputFontSize": 11,
  "terminal.integrated.fontSize": 9,
  "editor.minimap.sectionHeaderFontSize": 11,
  "liveServer.settings.donotShowInfoMsg": true,
  "chat.tools.terminal.autoApprove": {
    "sed": true,
    "nl": true,
    "cd \"/Users/oscarboczarski/Library/Mobile Documents/com~apple~CloudDocs/🔬Research+/🧑‍💻 Code.Base/DH-P3-1\" && nl -ba <(git show 8806fbdb612a6cf276cf8d9d001aa6bd9b11c5d1:DH_P2.53/styles/styles.css) | sed -n '1420,1445p'": {
      "approve": true,
      "matchCommandLine": true
    },
    "git difftool": true,
    "git checkout": true,
    "git rev-list": true
  },
  "remoteHub.commitDirectlyWarning": "off",
  "git.enableSmartCommit": true,
  "chat.edits2.enabled": true,
  "workbench.editor.enablePreview": false,

  "workbench.colorCustomizations": {
    "[Dracula Theme]": {
      "editor.selectionBackground": "#7430a4cb",
      "editor.inactiveSelectionBackground": "#7430a443",
      "editor.selectionHighlightBackground": "#8036b58a"
    }
  },

  "editor.tokenColorCustomizations": {
    "[Dracula Theme]": {
      "textMateRules": [
        {
          "name": "Strings → rose",
          "scope": [
            "string",
            "string.quoted",
            "string.quoted.double",
            "string.quoted.single",
            "string.template",
            "constant.character.escape"
          ],
          "settings": { "foreground": "#ff4d97" }
        },
        {
          "name": "HTML/JSX attribute names → rose",
          "scope": [
            "entity.other.attribute-name",
            "meta.tag.attribute",
            "support.variable.property.dom",
            "support.variable.property"
          ],
          "settings": { "foreground": "#46f8bd" }
        },
        {
          "name": "Markdown comments → salmon",
          "scope": [
            "text.html.markdown comment",
            "text.html.markdown punctuation.definition.comment"
          ],
          "settings": { "foreground": "#FA8072" }
        }
      ]
    }
  },

  "editor.semanticTokenColorCustomizations": {
    "[Dracula Theme]": {
      "enabled": true,
      "rules": {
        "string": "#bc8692",
        "property": "#cbd6a2",
        "enumMember": "#e8738c"
      }
    }
  },

  /* ---------- TODO Highlight (JS only, literals) ---------- */
  "todohighlight.isEnable": true,
  "todohighlight.include": ["**/*.js"],
  "todohighlight.isCaseSensitive": true,
  "todohighlight.defaultStyle": {
    "backgroundColor": "#00000000",
    "overviewRulerColor": "#00000000",
    "border": "none"
  },

  "todohighlight.keywords": [
    /* ===== Containers / Structure → #9300ff ===== */
    /* Opening tags WITHOUT attributes (includes '>') */
    { "text": "<div>", "color": "#9300ff" },
    { "text": "<span>", "color": "#9300ff" },
    { "text": "<p>", "color": "#9300ff" },
    { "text": "<section>", "color": "#9300ff" },
    { "text": "<article>", "color": "#9300ff" },
    { "text": "<header>", "color": "#9300ff" },
    { "text": "<footer>", "color": "#9300ff" },
    { "text": "<main>", "color": "#9300ff" },
    { "text": "<nav>", "color": "#9300ff" },
    { "text": "<aside>", "color": "#9300ff" },
    { "text": "<figure>", "color": "#9300ff" },
    { "text": "<figcaption>", "color": "#9300ff" },
    { "text": "<address>", "color": "#9300ff" },
    { "text": "<ul>", "color": "#9300ff" },
    { "text": "<ol>", "color": "#9300ff" },
    { "text": "<li>", "color": "#9300ff" },
    { "text": "<dl>", "color": "#9300ff" },
    { "text": "<dt>", "color": "#9300ff" },
    { "text": "<dd>", "color": "#9300ff" },
    { "text": "<h1>", "color": "#9300ff" },
    { "text": "<h2>", "color": "#9300ff" },
    { "text": "<h3>", "color": "#9300ff" },
    { "text": "<h4>", "color": "#9300ff" },
    { "text": "<h5>", "color": "#9300ff" },
    { "text": "<h6>", "color": "#9300ff" },
    /* Self/void tags */
    { "text": "<br>", "color": "#9300ff" },
    { "text": "<hr>", "color": "#9300ff" },

    /* Closing tags (always no attributes; includes '>') */
    { "text": "</div>", "color": "#9300ff" },
    { "text": "</span>", "color": "#9300ff" },
    { "text": "</p>", "color": "#9300ff" },
    { "text": "</section>", "color": "#9300ff" },
    { "text": "</article>", "color": "#9300ff" },
    { "text": "</header>", "color": "#9300ff" },
    { "text": "</footer>", "color": "#9300ff" },
    { "text": "</main>", "color": "#9300ff" },
    { "text": "</nav>", "color": "#9300ff" },
    { "text": "</aside>", "color": "#9300ff" },
    { "text": "</figure>", "color": "#9300ff" },
    { "text": "</figcaption>", "color": "#9300ff" },
    { "text": "</address>", "color": "#9300ff" },
    { "text": "</ul>", "color": "#9300ff" },
    { "text": "</ol>", "color": "#9300ff" },
    { "text": "</li>", "color": "#9300ff" },
    { "text": "</dl>", "color": "#9300ff" },
    { "text": "</dt>", "color": "#9300ff" },
    { "text": "</dd>", "color": "#9300ff" },
    { "text": "</h1>", "color": "#9300ff" },
    { "text": "</h2>", "color": "#9300ff" },
    { "text": "</h3>", "color": "#9300ff" },
    { "text": "</h4>", "color": "#9300ff" },
    { "text": "</h5>", "color": "#9300ff" },
    { "text": "</h6>", "color": "#9300ff" },

    /* ===== Styling / Emphasis → #00aabb ===== */
    /* Opening tags WITHOUT attributes (includes '>') */
    { "text": "<b>", "color": "#00aabb" },
    { "text": "<strong>", "color": "#00aabb" },
    { "text": "<u>", "color": "#00aabb" },
    { "text": "<i>", "color": "#00aabb" },
    { "text": "<em>", "color": "#00aabb" },
    { "text": "<small>", "color": "#00aabb" },
    { "text": "<mark>", "color": "#00aabb" },
    { "text": "<s>", "color": "#00aabb" },
    { "text": "<del>", "color": "#00aabb" },
    { "text": "<ins>", "color": "#00aabb" },
    { "text": "<sub>", "color": "#00aabb" },
    { "text": "<sup>", "color": "#00aabb" },

    /* Closing tags (includes '>') */
    { "text": "</b>", "color": "#00aabb" },
    { "text": "</strong>", "color": "#00aabb" },
    { "text": "</u>", "color": "#00aabb" },
    { "text": "</i>", "color": "#00aabb" },
    { "text": "</em>", "color": "#00aabb" },
    { "text": "</small>", "color": "#00aabb" },
    { "text": "</mark>", "color": "#00aabb" },
    { "text": "</s>", "color": "#00aabb" },
    { "text": "</del>", "color": "#00aabb" },
    { "text": "</ins>", "color": "#00aabb" },
    { "text": "</sub>", "color": "#00aabb" },
    { "text": "</sup>", "color": "#00aabb" }
  ],

  /* ----------------------------------- */

  "liveServer.settings.port": 5501,
  "editor.colorDecorators": true,
  "editor.colorDecoratorsLimit": 2200
}